# קובץ סביבה לדוגמה. העתיקו אותו לקובץ בשם .env ומלאו ערכים לפי הצורך.
# הקובץ .env נשאר במחשב בלבד ולעולם לא מועלה למאגר (ראו .gitignore).

# ---------- מצב עבודה ----------
# simulation = סימולציה על נתוני שוק אמיתיים, ללא כסף.
# live = מסחר אמיתי. בגרסה זו המצב חסום בקוד ואינו פעיל.
MODE=simulation

# ---------- זירה: Kraken ----------
# מפתחות ה-API נדרשים רק למסחר אמיתי. בסימולציה השאירו ריק.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# מטבע הציטוט שבו נמדדת היתרה. כל הזוגות שנסרקים הם מול מטבע זה.
QUOTE_CURRENCY=USD

# ---------- יתרה ומגבלות קשיחות ----------
# יתרת הסימולציה ההתחלתית, במטבע הציטוט.
START_BALANCE=100
# הפסד יומי מרבי באחוזים מההון בתחילת היום. בחריגה: עצירת חירום אוטומטית.
MAX_DAILY_LOSS_PCT=50
# גודל פוזיציה מרבי באחוזים מההון הנוכחי.
MAX_POSITION_PCT=50
# סיכון מרבי לעסקה בודדת באחוזים מההון (המרחק עד הסטופ-לוס כפול גודל הפוזיציה).
RISK_PER_TRADE_PCT=2
# מספר פוזיציות פתוחות מרבי בו-זמנית.
MAX_OPEN_POSITIONS=3

# ---------- אסטרטגיית כניסה ויציאה ----------
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
MAX_HOLD_MINUTES=120
# סטופ נגרר: אחרי שהמחיר עלה TRAILING_START_PCT אחוז מעל הכניסה, הסטופ נשמר
# TRAILING_STOP_PCT אחוז מתחת למחיר הגבוה ביותר שנרשם, ורק עולה. 0 מכבה את המנגנון.
TRAILING_START_PCT=3
TRAILING_STOP_PCT=2
# יחס קפיצת נפח: נפח הנר האחרון חלקי ממוצע הנרות הקודמים.
VOLUME_SPIKE_RATIO=3
# שינוי מחיר מינימלי באחוזים (מחיר אחרון מול פתיחת היום) כדי להיחשב מומנטום.
MIN_PRICE_CHANGE_PCT=1

# ---------- סינון איכות (מחליף את בדיקת ההונאות בזירה מרכזית) ----------
# נפח מסחר מינימלי ב-24 שעות, במטבע הציטוט.
MIN_VOLUME_24H=200000
# מרווח מרבי בין קנייה למכירה באחוזים.
MAX_SPREAD_PCT=0.8
# המתנה מינימלית בדקות לפני מסחר בזוג חדש שזה עתה נרשם.
NEW_PAIR_WAIT_MINUTES=30
# מספר הזוגות המובילים שעבורם נמשכים נרות (OHLC) בכל סבב סריקה.
OHLC_CANDIDATES=12

# ---------- סימולציית ביצוע ----------
# סליפג' מדומה באחוזים, בנוסף למרווח האמיתי בשוק.
SIM_SLIPPAGE_PCT=0.1
# עמלת ברירת מחדל באחוזים אם Kraken לא מחזירה טבלת עמלות לזוג.
DEFAULT_TAKER_FEE_PCT=0.4

# ---------- תזמון ושרת ----------
SCAN_INTERVAL_SECONDS=60
HOST=127.0.0.1
PORT=8000
DB_PATH=data/trader.db
